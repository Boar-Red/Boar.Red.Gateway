<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
		<Configurations>Debug;Release;Debug_Kestrel;Release_Kestrel</Configurations>
		<Version>10.0.0</Version>
		<Nullable>enable</Nullable>
		<FileVersion>10.0.0</FileVersion>
		<ApplicationIcon>Boar_Red_600x600@1x.ico</ApplicationIcon>
		<PackageIcon>Boar_Red_600x600@1x.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<AssemblyVersion>10.0.0</AssemblyVersion>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Boar-Red/Boar.Red.Gateway</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Boar-Red/Boar.Red.Gateway</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);TRACE;ROUTER_WEBSERVER_IIS</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug_Kestrel|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;ROUTER_WEBSERVER_KESTREL</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants>$(DefineConstants);ROUTER_WEBSERVER_IIS</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_Kestrel|AnyCPU'">
		<DefineConstants>$(DefineConstants);ROUTER_WEBSERVER_KESTREL</DefineConstants>
		<Optimize>True</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Attributes\**" />
		<Compile Remove="Data\**" />
		<Compile Remove="Migrations\**" />
		<Compile Remove="日志文件\**" />
		<Content Remove="Attributes\**" />
		<Content Remove="Data\**" />
		<Content Remove="Migrations\**" />
		<Content Remove="日志文件\**" />
		<EmbeddedResource Remove="Attributes\**" />
		<EmbeddedResource Remove="Data\**" />
		<EmbeddedResource Remove="Migrations\**" />
		<EmbeddedResource Remove="日志文件\**" />
		<None Remove="Attributes\**" />
		<None Remove="Data\**" />
		<None Remove="Migrations\**" />
		<None Remove="日志文件\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Boar_Red_600x600@1x.ico" />
		<Content Include="Directory.Build.props" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="CertificateFiles\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Boar.Red.Service\Boar.Red.Service\Boar.Red.Service.csproj" />
		<ProjectReference Include="..\Boar.Red.Gateway.Defines\Boar.Red.Gateway.Defines.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="ConfigFiles\RouterConfig.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Update="Boar_Red_600x600%401x.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
